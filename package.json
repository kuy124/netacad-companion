{
  "name": "netacad-companion",
  "version": "0.1.3",
  "description": "Chapter checklists and answer assistance for NetAcad.",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kuy124/netacad-companion.git"
  },
  "scripts": {
    "start": "webpack --watch --progress --config webpack.dev.js",
    "build": "webpack --progress --config webpack.prod.js",
    "build:firefox": "webpack --progress --config webpack.firefox.js",
    "package:chromium": "npm run build && node scripts/package.mjs chromium",
    "package:firefox": "npm run build:firefox && node scripts/package.mjs firefox",
    "package": "npm run package:chromium && npm run package:firefox",
    "test": "node test/stress.mjs",
    "test:browser": "node test/browser.mjs",
    "test:documents": "node test/documents.mjs",
    "test:packages": "node test/packages.mjs"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "jsdom": "^29.1.1",
    "source-map-loader": "^5.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
